<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProblemasActivity">

    <TextView
        android:id="@+id/textView14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="87dp"
        android:layout_marginTop="32dp"
        android:text="ELEIÇÕES 2026"
        android:textSize="34sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="71dp"
        android:layout_marginTop="20dp"
        android:text="PESQUISA DE PROBLEMAS"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView14" />

    <TextView
        android:id="@+id/textView13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="166dp"
        android:layout_marginTop="18dp"
        android:text="Fase 3/3"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView11" />

    <TextView
        android:id="@+id/textView12"
        android:layout_width="289dp"
        android:layout_height="85dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:text="Selecione os 3 assuntos mais importantes para você:"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView13" />

    <LinearLayout
        android:id="@+id/linearProblemas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView12">

        <CheckBox
            android:id="@+id/cbSaude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saúde" />

        <CheckBox
            android:id="@+id/cbSeguranca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Segurança" />

        <CheckBox
            android:id="@+id/cbEducacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Educação" />

        <CheckBox
            android:id="@+id/cbTurismo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Turismo" />

        <CheckBox
            android:id="@+id/cbAgricultura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agricultura" />

        <CheckBox
            android:id="@+id/cbPecuaria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pecuária" />

        <CheckBox
            android:id="@+id/cbExtrativismo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Extrativismo" />
    </LinearLayout>

    <Button
        android:id="@+id/btConfirmar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Enviar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearProblemas" />

</androidx.constraintlayout.widget.ConstraintLayout>